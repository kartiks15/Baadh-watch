# Copernicus Data Space Ecosystem → Sentinel Hub OAuth client (free):
#   https://shapps.dataspace.copernicus.eu/dashboard/ → User settings → OAuth clients → Create
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# Optional: enables the AI-written situation report and Q&A (numbers still come only from the map data).
# Set ONE of these. Anthropic direct is used if both are set (override with LLM_PROVIDER=openrouter).
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-opus-5.5
# OPENROUTER_MAX_TOKENS=8000  (lower it if OpenRouter returns 402 for an expensive model)
